# Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Postgres (pgvector) — for RAG doc chunks only
DATABASE_URL=postgresql://user:password@localhost:5432/babyagent

# Terminal3 ADK — for sensitive baby profiles and logs
TERMINAL3_ENABLED=false
TERMINAL3_API_KEY=
TERMINAL3_BASE_URL=

# Embeddings provider: "local" uses @xenova/transformers MiniLM (no API key needed)
# "openai" uses text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=local
OPENAI_API_KEY=
